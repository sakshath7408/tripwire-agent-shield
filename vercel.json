{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "sh web/build.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/run.py": {
      "includeFiles": "{web/demo_runner.py,demo/run_demo.py,demo/world/__init__.py,demo/world/agent.py,demo/world/world.py,demo/world/fixtures/**,demo/poisoned-repo/**,src/tripwire/**}",
      "excludeFiles": "{**/__pycache__/**,demo/world/sandbox/**,demo/world/attacker_drop.json,demo/world/ollama_planner.py}",
      "maxDuration": 10
    }
  },
  "rewrites": [{ "source": "/pitch", "destination": "/pitch/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/(static/.*|demo.*|)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
